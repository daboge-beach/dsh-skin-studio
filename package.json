{
  "name": "dsh-skin-studio",
  "version": "0.5.0",
  "description": "DeepSeek Harness 皮肤工作室 — 内置精选皮肤 + 用户上传皮肤中心",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/skins/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "pnpm -r typecheck",
    "validate-skins": "node scripts/validate-skins.mjs",
    "clean": "pnpm -r exec rm -rf lib dist node_modules",
    "setup": "pnpm install && node scripts/download-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "skin",
    "theme",
    "plugin",
    "agent-ui",
    "league-of-legends",
    "lol",
    "lol-skins",
    "fanren-xiuxian-zhuan",
    "a-record-of-a-mortals-journey",
    "xiuxian",
    "cultivation",
    "donghua",
    "chinese-novel",
    "anime-skins",
    "glassmorphism",
    "mascot"
  ],
  "license": "MIT",
  "author": "大博哥 <768839134@qq.com>",
  "homepage": "https://github.com/daboge-beach/dsh-skin-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/daboge-beach/dsh-skin-studio.git"
  },
  "bugs": {
    "url": "https://github.com/daboge-beach/dsh-skin-studio/issues"
  }
}
