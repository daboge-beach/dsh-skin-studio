{
  "name": "dsh-skin-studio",
  "version": "0.17.0",
  "description": "DeepSeek Harness 皮肤工作室 — 内置精选皮肤 + 用户上传皮肤中心",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/skins/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "validate-skins": "node scripts/validate-skins.mjs",
    "clean": "node scripts/clean.mjs",
    "setup": "pnpm install && node scripts/download-assets.mjs",
    "gen:quotes": "node --experimental-strip-types scripts/gen-quotes.mjs",
    "gen:skin-data": "node scripts/gen-skin-data.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "gen:skin": "node scripts/create-skin.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && node scripts/gen-skin-data.mjs --check && node --experimental-strip-types scripts/gen-quotes.mjs --check && pnpm build && pnpm check:bundle && pnpm validate-skins",
    "install-to-dsh": "node scripts/install-to-dsh.mjs",
    "gen:social-preview": "node --experimental-strip-types scripts/gen-social-preview.mjs",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "skin",
    "theme",
    "plugin",
    "agent-ui",
    "league-of-legends",
    "lol",
    "lol-skins",
    "fanren-xiuxian-zhuan",
    "a-record-of-a-mortals-journey",
    "xiuxian",
    "cultivation",
    "donghua",
    "chinese-novel",
    "anime-skins",
    "glassmorphism",
    "mascot"
  ],
  "license": "MIT",
  "author": "大博哥 <768839134@qq.com>",
  "homepage": "https://github.com/daboge-beach/dsh-skin-studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/daboge-beach/dsh-skin-studio.git"
  },
  "bugs": {
    "url": "https://github.com/daboge-beach/dsh-skin-studio/issues"
  }
}
