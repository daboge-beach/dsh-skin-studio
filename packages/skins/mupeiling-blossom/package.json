  "scripts": {
    "build": "tsdown src/index.ts --format esm --out-dir lib",
    "dev": "tsdown src/index.ts --format esm --out-dir lib --watch"
  },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  },
