{
  "name": "@dsh-skin-studio/gallery",
  "version": "0.15.0",
  "description": "DSH Skin Studio — 皮肤中心（浏览 / 试穿 / 应用 / 上传皮肤 + 内置 7 款皮肤主题 + /skins 静态资源路由）",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "dev",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "node ../../scripts/sync-host-manifest.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@dsh-skin-studio/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "lightningcss": "^1.32.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skin",
    "gallery",
    "plugin"
  ],
  "license": "MIT",
  "author": "DSH Skin Studio",
  "homepage": "https://github.com/daboge-beach/dsh-skin-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/daboge-beach/dsh-skin-studio.git",
    "directory": "packages/gallery"
  }
}
