# 统一行尾为 LF（跨平台协作）
* text=auto eol=lf
# Windows 批处理强制 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
packages/skins/**/*.png filter=lfs diff=lfs merge=lfs -text
