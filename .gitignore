# 本地皮肤开发（用户上传的临时皮肤不入库）
packages/uploads/

# Token 文件（防止误提交）
**/gittoken*
**/.github_token*
**/.env.secret

# 本地自检截图（浏览器验证产物，不入库）
.selfcheck/

# gallery 插件配置编译产物（tsdown 构建时会顺带编译 config 自身，源文件为 *.config.ts）
packages/gallery/*.config.js
packages/gallery/*.config.js.map
packages/gallery/*.config.d.ts
packages/gallery/*.config.d.ts.map
assets/skins/
packages/skins/*/assets/tiers/*/bg.custom.png
# 皮肤资产（生图 PNG）不进 git——由 GitHub Releases 下载（scripts/download-assets.mjs）
packages/skins/*/assets/**/*.png
packages/skins/*/preview.png
packages/skins/*/hero.png
packages/skins/*/sprite_anim.png
packages/skins/*/bg.png
packages/skins/FANREN_README.md
